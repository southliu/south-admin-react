{
  "name": "south-admin-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://github.com/southliu/south-admin-react",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/generate-icons.mjs && tsc && vite build",
    "build:analyze": "cross-env ANALYZE=true pnpm build",
    "build:dev": "node scripts/generate-icons.mjs && tsc && vite build --mode dev",
    "build:test": "node scripts/generate-icons.mjs && tsc && vite build --mode test",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx --fix",
    "lint:stylelint": "stylelint --cache --fix \"**/*.{less,postcss,css,scss}\" --cache --cache-location node_modules/.cache/stylelint/",
    "preview": "vite preview",
    "prepare": "husky",
    "prettier": "prettier --write .",
    "init:project": "node .claude/skills/init-project/scripts/init.mjs",
    "predev": "node scripts/generate-icons.mjs",
    "lint:check": "eslint . --ext .js,.ts,.jsx,.tsx",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.2.0",
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@south/message": "workspace:^",
    "@south/request": "workspace:^",
    "@south/utils": "workspace:^",
    "@wangeditor/editor": "^5.1.23",
    "@wangeditor/editor-for-react": "^1.0.6",
    "antd": "^6.7.1",
    "axios": "^1.21.1",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "i18next": "^27.2.2",
    "i18next-browser-languagedetector": "^8.3.1",
    "keepalive-for-react": "^6.0.0",
    "lodash": "^4.18.1",
    "nprogress": "^0.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-draggable": "^4.7.2",
    "react-i18next": "^18.0.3",
    "react-resizable": "^4.0.2",
    "react-router-dom": "^7.18.6",
    "react-window": "^2.5.3",
    "zustand": "^5.1.0",
    "@iconify/react": "^6.0.4",
    "@sentry/react": "^11.16.0",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@south/stylelint": "workspace:^",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.6",
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "stylelint": "^18.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "unocss": "^66.13.0",
    "vite": "^8.3.8",
    "vite-plugin-compression": "^0.5.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@iconify-json/ant-design": "^1.2.9",
    "@iconify-json/cil": "^1.2.3",
    "@iconify-json/fluent": "^1.2.62",
    "@iconify-json/gg": "^1.2.2",
    "@iconify-json/gridicons": "^1.2.5",
    "@iconify-json/icon-park": "^1.2.4",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/ion": "^1.2.7",
    "@iconify-json/la": "^1.2.1",
    "@iconify-json/majesticons": "^1.2.5",
    "@iconify-json/material-symbols": "^1.2.101",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/uil": "^1.2.3"
  },
  "packageManager": "pnpm@11.9.0"
