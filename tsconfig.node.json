{
  "compilerOptions": {
    "composite": true,
    "rewriteRelativeImportExtensions": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true
  },
  "include": ["vite.config.ts", "build/**/*.ts"]
}
